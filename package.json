{
  "name": "local-twitch-reporting-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop reports for archived Twitch channel activity",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",

  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.4.1"
  },
  "productName": "Local Twitch Reporting Dashboard",
  "allowScripts": {
    "electron@45.4.1": true
  }
}

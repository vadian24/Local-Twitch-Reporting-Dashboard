{
  "name": "local-twitch-reporting-dashboard",
  "version": "1.4.0",
  "private": true,
  "description": "Desktop reports for archived Twitch channel activity",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "package": "electron-packager . Local-Twitch-Reporting-Dashboard --out=dist --overwrite --asar --ignore=\"/test($|/)\"",
    "package:windows": "electron-builder --win nsis --x64 --publish never"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.1"
  },
  "productName": "Local Twitch Reporting Dashboard",
  "allowScripts": {
    "electron@45.4.1": true
  },
  "author": "Argas",
  "build": {
    "appId": "com.vadian24.local-twitch-reporting-dashboard",
    "executableName": "Local-Twitch-Reporting-Dashboard",
    "directories": {
      "output": "dist/windows"
    },
    "files": [
      "src/**/*",
      "assets/icon.png"
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "Local-Twitch-Reporting-Dashboard-Windows-x64-Setup.exe",
      "perMachine": false,
      "oneClick": false,
      "allowElevation": false,
      "differentialPackage": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Local Twitch Reporting Dashboard"
    }
  },
  "desktopName": "com.vadian24.local-twitch-reporting-dashboard.desktop",
  "dependencies": {
    "sigstore": "5.0.0"
  }
}
